---
import Media from './Media.astro';
import { work } from '../config/site';
---

<section class="section work" aria-labelledby="work-title">
  <div class="wrap">
    <div class="work__head">
      <h2 id="work-title" class="h1" data-reveal>{work.headline}</h2>
      <p class="lead muted" data-reveal style="--i: 1">{work.body}</p>
    </div>

    <ul role="list" class="work__grid">
      {
        work.items.map((item, i) => (
          <li class:list={['work__item', `work__item--${i + 1}`]} data-reveal style={`--i: ${i % 2}`}>
            <Media slot={item.key} sizes="(min-width: 900px) 50vw, 100vw" />
            <p class="work__caption">
              <span class="work__n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              {item.caption}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .work__head {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gutter);
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .work__head .h1 {
    grid-column: 1 / span 6;
  }
  .work__head .lead {
    grid-column: 8 / -1;
  }

  /* Staggered editorial grid: large / small, then small / large */
  .work__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(2.5rem, 4vw, 4rem) var(--gutter);
    align-items: start;
  }
  .work__item--1 {
    grid-column: 1 / span 7;
  }
  .work__item--2 {
    grid-column: 9 / -1;
    margin-top: clamp(4rem, 12vw, 11rem);
  }
  .work__item--3 {
    grid-column: 1 / span 5;
    margin-top: 0;
  }
  .work__item--4 {
    grid-column: 7 / -1;
    margin-top: clamp(3rem, 8vw, 7rem);
  }

  .work__item :global(.media) {
    transition: transform 500ms var(--ease);
  }
  .work__item:hover :global(.media) {
    transform: translateY(-6px);
  }

  .work__caption {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--rule);
    font-weight: 700;
    font-size: var(--fs-m);
    letter-spacing: -0.02em;
  }
  .work__n {
    font-size: var(--fs-s);
    font-weight: 600;
    font-stretch: 120%;
    color: var(--ink-soft);
  }

  @media (max-width: 900px) {
    .work__head .h1,
    .work__head .lead {
      grid-column: 1 / -1;
    }
    .work__grid {
      grid-template-columns: 1fr 1fr;
    }
    .work__grid > li {
      grid-column: 1 / -1;
      margin-top: 0;
    }
  }
  @media (min-width: 600px) and (max-width: 900px) {
    .work__item--2,
    .work__item--3 {
      grid-column: span 1 !important;
    }
  }
</style>
