---
import { brand } from '../config/site';

interface Props {
  size?: 'default' | 'huge';
  as?: 'a' | 'span';
}
const { size = 'default', as = 'a' } = Astro.props;
const Tag = as;
const chars = brand.name.length + 0.4; // + the dot
---

<Tag class:list={['wordmark', `wordmark--${size}`]} style={`--chars: ${chars}`} href={as === 'a' ? '#top' : undefined} aria-label={as === 'a' ? `${brand.name}, back to top` : undefined}>
  {brand.name}<span class="wordmark__dot" aria-hidden="true">.</span>
</Tag>

<style>
  .wordmark {
    font-weight: 900;
    font-stretch: 125%;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1;
    white-space: nowrap;
  }
  .wordmark--default {
    font-size: 1.375rem;
  }
  .wordmark--huge {
    display: block;
    /* Fills its container whatever the brand name's length. */
    font-size: calc(100cqi / (var(--chars) * 0.78));
    letter-spacing: -0.05em;
    line-height: 0.8;
  }
  .wordmark__dot {
    color: var(--accent);
  }
  a.wordmark:hover .wordmark__dot {
    color: inherit;
  }
</style>
