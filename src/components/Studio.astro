---
import Media from './Media.astro';
import { studio } from '../config/site';
---

<section id="studio" class="section studio" aria-labelledby="studio-title">
  <div class="wrap">
    <div class="studio__head">
      <p class="eyebrow" data-reveal>The studio</p>
      <h2 id="studio-title" class="h1" data-reveal style="--i: 1">{studio.headline}</h2>
      <p class="lead muted studio__body" data-reveal style="--i: 2">{studio.body}</p>
    </div>

    <div class="studio__photo" data-reveal>
      <Media slot="studio" sizes="(min-width: 1520px) 1440px, 100vw" />
    </div>
  </div>
</section>

<style>
  .studio {
    border-top: 1px solid var(--rule);
  }
  .studio__head {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 0 var(--gutter);
    align-items: end;
  }
  .studio__head .eyebrow {
    grid-column: 1 / -1;
  }
  .studio__head .h1 {
    grid-column: 1 / span 8;
    margin-top: 1.25rem;
  }
  .studio__body {
    grid-column: 9 / -1;
    max-width: 36ch;
  }
  .studio__photo {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  @media (max-width: 1000px) {
    .studio__head .h1,
    .studio__body {
      grid-column: 1 / -1;
    }
    .studio__body {
      margin-top: 1.75rem;
      max-width: 44ch;
    }
  }
  @media (max-width: 599px) {
    .studio__photo {
      margin-inline: calc(var(--gutter) * -1);
    }
    .studio__photo :global(.media) {
      aspect-ratio: 4 / 3;
    }
  }
</style>
