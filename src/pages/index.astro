---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import Packages from '../components/Packages.astro';
import WorldFeature from '../components/WorldFeature.astro';
import WorkPreview from '../components/WorkPreview.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Studio from '../components/Studio.astro';
import FAQ from '../components/FAQ.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import IntakeDialog from '../components/IntakeDialog.astro';
import ContactDialog from '../components/ContactDialog.astro';
---

<Base>
  <Header />
  <main id="main">
    <Hero />
    <Intro />
    <Packages />
    <WorldFeature />
    <WorkPreview />
    <HowItWorks />
    <Studio />
    <FAQ />
    <FinalCta />
  </main>
  <Footer />
  <IntakeDialog />
  <ContactDialog />
</Base>
