# Copy to .env and fill in before launch.

# Production URL (canonical + social sharing image URLs).
SITE_URL=https://sitesonic.example

# Endpoint that receives package requests as a JSON POST.
# Works with Formspree, Basin, Getform, or your own serverless function.
# Leave empty and the form shows a "not connected" notice. It never shows
# a success state unless the endpoint returns a 2xx response.
PUBLIC_INTAKE_ENDPOINT=
